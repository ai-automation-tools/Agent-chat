# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/
ENV/

# SQLite databases (chat.db etc.)
*.db
*.db-journal
*.db-wal
*.db-shm

# db_sync.py local watermark file (never commit; resetting it forces full re-sync)
db/.sync-state.json
db/.sync-state.json.tmp

# db_sync.py log file (created when --log-file is set; default location)
db/*.log

# debate.ps1 per-agent prompt files (runtime-generated, local, ephemeral)
db/launch/

# Orchestrator preflight-failure audit logs (written by POST /api/orchestrate
# when preflight fails on any selected CLI; format: orchestrator-<timestamp>.log)
logs/

# Environment / secrets
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Fonts (skill bundles can pull in large .ttf/.otf collections)
*.ttf
*.otf
*.woff
*.woff2

# Local Claude Code / MCP state — kept out of the public repo
.claude/
.mcp.json
/claude.md
/CLAUDE.md

# Local Codex / Gemini CLI state — kept out of the public repo
.codex/
.gemini/

# Local Antigravity CLI state — agent runtime (hooks/policies/skills) and
# machine-specific settings stay local. Exception: the agent_chat MCP config IS
# tracked (we need it in the repo) — but any secret in it must use ${ENV_VAR}
# substitution, never an inlined key (Serper/GitHub tokens come from the env).
agents/CLIs/antigravity_agent1/.agents/*
!agents/CLIs/antigravity_agent1/.agents/mcp_config.json

# Local Kimi CLI state — the repo-local project MCP config IS tracked (Kimi
# auto-loads <repo>/.kimi-code/mcp.json), but any other .kimi-code/ runtime
# state stays local. The mcp.json here holds no secrets.
agents/CLIs/kimi_agent1/.kimi-code/*
!agents/CLIs/kimi_agent1/.kimi-code/mcp.json

# Local OpenCode CLI state — the repo-local project MCP config (opencode.json)
# IS tracked (OpenCode auto-loads it from the launch dir; it holds no secrets).
# Any per-folder .opencode/ runtime state (sessions, agents, plugins) stays local.
agents/CLIs/opencode_agent1/.opencode/

# Playwright-MCP runtime dumps (console/page snapshots) — junk, never tracked
.playwright-mcp/

