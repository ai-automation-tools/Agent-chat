# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/
ENV/

# SQLite databases (chat.db etc.)
*.db
*.db-journal
*.db-wal
*.db-shm

# db_sync.py local watermark file (never commit; resetting it forces full re-sync)
db/.sync-state.json
db/.sync-state.json.tmp

# db_sync.py log file (created when --log-file is set; default location)
db/*.log

# debate.ps1 per-agent prompt files (runtime-generated, local, ephemeral)
db/launch/

# Orchestrator preflight-failure audit logs (written by POST /api/orchestrate
# when preflight fails on any selected CLI; format: orchestrator-<timestamp>.log)
logs/

# Operator-only hosting docs — this machine's public Fly mirror, the DB-sync
# sidecar that feeds it, and the logon autostart task. None of it is needed to
# run Agent-Chat locally, and all of it is specific to one deployment, so it
# stays out of the public repo. Nothing tracked may link into this folder.
docs/Local/

# Environment / secrets
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Fonts (skill bundles can pull in large .ttf/.otf collections)
*.ttf
*.otf
*.woff
*.woff2

# Local Claude Code / MCP state — kept out of the public repo, EXCEPT the
# shared agent / skill / command definitions, which are tracked so a clone gets
# the same Claude Code tooling. Everything else under .claude/ (settings.local.json,
# local-vs-public.md, images/, rules/, temp/) stays local.
.claude/*
!.claude/agents/
!.claude/commands/
!.claude/skills/

# ...but not the per-clone skill links that scripts/setup/setup-skill-links.ps1
# generates from the repo's own skills/ — they're absolute-path symlinks to
# already-tracked content, so committing them would just bake in this machine's
# paths. Run the setup script after cloning to recreate them.
#
# NOTE: this list is by name, so ADDING A SKILL UNDER skills/ REQUIRES A LINE
# HERE TOO. The link script needs no edit (it links every skills/ subfolder),
# but without the matching line the junction gets committed as duplicate files.
.claude/skills/agent-chat/
.claude/skills/battleground/
.claude/skills/debate-mode/
.claude/skills/podcast-mode/
.claude/skills/humanizer/
.claude/skills/start-debate/
.claude/skills/publish-debate/

# The un-ignore above is anchored to the repo-root .claude/ (a pattern with a
# slash in it always is). Nested per-CLI tester Claude state is NOT tracked —
# re-ignore it at any depth, the way the old blanket `.claude/` rule did.
**/*/.claude/

# CLAUDE.md IS tracked — it's the project instruction file, and a clone needs it.
# (core.ignorecase=true here, so claude.md and CLAUDE.md are the same file; both
# patterns had to go.)
.mcp.json

# Local Codex / Gemini CLI state — kept out of the public repo
.codex/
.gemini/

# Local Antigravity CLI state — agent runtime (hooks/policies/skills) and
# machine-specific settings stay local. Exception: the agent_chat MCP config IS
# tracked (we need it in the repo) — but any secret in it must use ${ENV_VAR}
# substitution, never an inlined key (Serper/GitHub tokens come from the env).
agents/CLIs/antigravity_agent1/.agents/*
!agents/CLIs/antigravity_agent1/.agents/mcp_config.json

# Local Kimi CLI state — the repo-local project MCP config IS tracked (Kimi
# auto-loads <repo>/.kimi-code/mcp.json), but any other .kimi-code/ runtime
# state stays local. The mcp.json here holds no secrets.
agents/CLIs/kimi_agent1/.kimi-code/*
!agents/CLIs/kimi_agent1/.kimi-code/mcp.json

# Local OpenCode CLI state — the repo-local project MCP config (opencode.json)
# IS tracked (OpenCode auto-loads it from the launch dir; it holds no secrets).
# Any per-folder .opencode/ runtime state (sessions, agents, plugins) stays local.
agents/CLIs/opencode_agent1/.opencode/

# Temp Agents to Import
agents/Debate-Agents/

# Playwright-MCP runtime dumps (console/page snapshots) — junk, never tracked
.playwright-mcp/

