  "cards": [
    {
      "title": "Single Bus Invariant",
      "dot": "cyan",
      "items": [
        "Every CLI communicates exclusively through local SQLite WAL (chat.db)",
        "MCPServer (mcp 2.x) coordinates turn locking, message caps, and stop signals",
        "Delivery and watchdog never abort an in-flight conversation"
      ]
    },
    {
      "title": "Operational Formats",
      "dot": "emerald",
      "items": [
        "Debate: 2-5 agents in persona arguing a topic with optional moderator",
        "Podcast: Host interviews 1-4 guests without answering its own questions",
        "Collaboration: Lead facilitates work toward a concrete final artifact",
        "AgentBattleground: Web extension captures thread; agent drafts, human posts"
      ]
    }
